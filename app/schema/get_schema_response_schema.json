{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetSchemaResponse",
  "description": "Response schema for the get_schema tool: the Artsdata data model (ontology + CORE graph SHACL shapes) compiled into a class-centric digest. IRIs are CURIEs over `prefixes` (or <full-IRI> when no prefix fits); property paths are SPARQL 1.1 property paths.",
  "version": "1.0.0",
  "type": "object",
  "required": ["about", "conventions", "prefixes", "classes", "vocabularies"],
  "properties": {
    "about": {
      "type": "object",
      "required": ["source", "sparql_endpoint"],
      "properties": {
        "namespace": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "modified": { "type": "string" },
        "source": { "type": "string", "format": "uri", "description": "Turtle file the digest was compiled from." },
        "sparql_endpoint": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "conventions": {
      "type": "array",
      "description": "How to read the digest and write SPARQL against the graph.",
      "items": { "type": "string" }
    },
    "prefixes": {
      "type": "object",
      "description": "Prefix name -> namespace IRI.",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "properties"],
        "properties": {
          "class": { "type": "string", "description": "Class to use with rdf:type / a." },
          "label": { "type": "string" },
          "comment": { "type": "string" },
          "alternate_names": { "type": "array", "items": { "type": "string" } },
          "equivalent_classes": { "type": "array", "items": { "type": "string" } },
          "subclass_of": { "type": "array", "items": { "type": "string" } },
          "shapes": { "type": "array", "items": { "type": "string" }, "description": "SHACL node shapes merged into this entry." },
          "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
        },
        "additionalProperties": false
      }
    },
    "vocabularies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "scheme"],
        "properties": {
          "property": { "type": "string" },
          "scheme": { "type": "string", "description": "skos:ConceptScheme the property's values are in." },
          "label": { "type": "string" },
          "classes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "curies": { "type": "array", "items": { "type": "string" } },
    "property": {
      "type": "object",
      "required": ["path", "required"],
      "properties": {
        "path": { "type": "string", "description": "SPARQL property path." },
        "label": { "type": "string" },
        "required": { "type": "boolean", "description": "sh:minCount >= 1." },
        "min_count": { "type": "integer", "minimum": 2, "description": "Only present when greater than 1." },
        "max_count": { "type": "integer", "minimum": 0 },
        "node_kind": { "type": "string", "enum": ["IRI", "Literal", "BlankNode", "BlankNodeOrIRI", "BlankNodeOrLiteral", "IRIOrLiteral"] },
        "datatypes": { "$ref": "#/$defs/curies" },
        "classes": { "$ref": "#/$defs/curies", "description": "Class(es) of the linked node." },
        "in": { "type": "array", "items": { "type": "string" }, "description": "Allowed values." },
        "has_value": { "type": "array", "items": { "type": "string" } },
        "pattern": { "type": "string", "description": "Regex the value (as a string) matches." },
        "unique_lang": { "type": "boolean" },
        "language_in": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "description": "Omitted for sh:Violation." },
        "description": { "type": "string" },
        "range": { "$ref": "#/$defs/curies" },
        "sub_property_of": { "$ref": "#/$defs/curies" },
        "equivalent_properties": { "$ref": "#/$defs/curies" },
        "value_shape": {
          "type": "object",
          "required": ["properties"],
          "properties": {
            "label": { "type": "string" },
            "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
