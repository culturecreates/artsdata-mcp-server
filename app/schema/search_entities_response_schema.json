{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchEntitiesResponse",
  "description": "Response schema for the search_entities tool.",
  "version": "1.0.0",
  "type": "object",
  "required": ["id", "uri", "types", "name"],
  "properties": {
    "id": {
      "type": "string"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Concept"
      }
    },
    "name": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalizedString"
      }
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalizedString"
      }
    },
    "description": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalizedString"
      }
    },
    "main_entity_of_page": {
      "type": "string",
      "format": "uri"
    },
    "same_as": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "additional_properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AdditionalProperty"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Concept": {
      "type": "object",
      "required": ["uri", "label"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LocalizedString": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AdditionalProperty": {
      "type": "object",
      "required": ["predicate", "values"],
      "properties": {
        "predicate": {
          "$ref": "#/$defs/Concept"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}