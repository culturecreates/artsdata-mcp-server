{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchEventsResponse",
  "description": "Response schema for the search_events tool.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the entity."
          },
          "uri": {
            "type": "string",
            "format": "uri",
            "description": "URI representing the entity."
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/typeItem"
            }
          },
          "name": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/multiLingualString"
            }
          },
          "alternate_names": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/multiLingualString"
            }
          },
          "description": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/multiLingualString"
            }
          },
          "main_entity_of_page": {
            "type": "string",
            "format": "uri",
            "description": "URI of the main entity page."
          },
          "same_as": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "start_date": {
            "description": "Start date or start date-time of an event (ISO 8601).",
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "end_date": {
            "description": "End date or end date-time of an event (ISO 8601).",
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "event_status": {
            "type": "string",
            "format": "uri",
            "description": "Status of the event, it can one from the enumeration members of https://schema.org/EventStatusType"
          },
          "event_attendance_mode": {
            "type": "string",
            "format": "uri",
            "description": "Attendance mode of the event, it can one from the enumeration members of https://schema.org/EventAttendanceModeEnumeration"
          },
          "organizer": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uriList"
            },
            "description": "List of organizer URIs"
          },
          "performer": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uriList"
            },
            "description": "List of performer URIs"
          },
          "location": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uriList"
            },
            "description": "List of location URIs"
          },
          "additional_type": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uriList"
            },
            "description": "List of additional Type URIs"
          },
          "additional_properties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/additionalProperty"
            }
          }
        },
        "required": [
          "id",
          "uri",
          "types",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "typeItem": {
      "type": "object",
      "required": [
        "uri",
        "label"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "uriList": {
      "type": "string",
      "format": "uri"
    },
    "multiLingualString": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag (e.g., 'en', 'fr')."
        }
      },
      "additionalProperties": false
    },
    "additionalProperty": {
      "type": "object",
      "required": [
        "predicate",
        "values"
      ],
      "properties": {
        "predicate": {
          "type": "object",
          "required": [
            "uri",
            "label"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}